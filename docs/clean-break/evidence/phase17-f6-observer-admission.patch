+def cached_readiness_request(inputs: dict) -> dict:
+    pool = inputs["pool"]
+    dates = []
+    for key in ("start_date", "end_date"):
+        raw = pool[key]
+        require(isinstance(raw, str), "frozen cache date is not text")
+        try:
+            parsed = dt.date.fromisoformat(raw)
+        except ValueError as exc:
+            raise Stop("frozen cache date is invalid") from exc
+        require(parsed.isoformat() == raw, "frozen cache date is not canonical ISO")
+        dates.append(parsed)
+    require(dates[0] <= dates[1], "frozen cache date range is reversed")
+    return {"symbols": [pool["symbol"]], "start_date": dates[0].strftime("%Y%m%d"),
+            "end_date": dates[1].strftime("%Y%m%d"), "use_case": "backtest",
+            "data_requirements": inputs["strategy"].get("data_requirements", {})}
+
+
+def check_cached_readiness(reply, inputs: dict) -> dict:
+    body = reply.body
+    wanted = cached_readiness_request(inputs)
+    require(reply.status == 200 and reply.same_origin and isinstance(body, dict)
+            and body.get("schema_version") == "data-readiness-product.v1"
+            and body.get("verdict") == "usable" and body.get("checked_against") == "persisted_byq"
+            and all(body.get("scope", {}).get(key) == wanted[key]
+                    for key in ("symbols", "start_date", "end_date", "use_case"))
+            and body.get("summary", {}).get("required_sessions") == inputs["pool"]["sessions"]
+            and body.get("summary", {}).get("missing_items") == 0
+            and body.get("summary", {}).get("ready_items") == inputs["pool"]["sessions"]
+            and body.get("summary", {}).get("calendar_complete") is True,
+            "Product cache readiness does not prove the exact cached range usable")
+    return body
+
+
+def check_test_accounts(reply, expected_owner: str, expected_user_id: str) -> list[dict]:
+    body = reply.body
+    require(reply.status == 200 and reply.same_origin and isinstance(body, dict)
+            and set(body) == {"users"} and isinstance(body["users"], list)
+            and len(body["users"]) == 1, "dedicated test account scope changed")
+    user = body["users"][0]
+    require(isinstance(user, dict) and user.get("username") == expected_owner
+            and user.get("status") == "active" and isinstance(user.get("user_id"), str)
+            and user["user_id"] == expected_user_id, "dedicated sole test owner is invalid")
+    return [{key: user[key] for key in ("user_id", "username", "status")}]
+
+
+def check_signal_queue(reply, allowed_job_id: str | None = None) -> dict:
+    body = reply.body
+    require(reply.status == 200 and reply.same_origin and isinstance(body, dict)
+            and isinstance(body.get("jobs"), list) and type(body.get("total")) is int
+            and body["total"] == len(body["jobs"]) < 100,
+            "dedicated SignalJob catalog is unknown or incomplete")
+    rows = body["jobs"]
+    ids = [row.get("job_id") for row in rows if isinstance(row, dict)]
+    require(len(ids) == len(rows) and all(isinstance(jid, str) and jid.startswith("signaljob_") for jid in ids)
+            and len(set(ids)) == len(ids), "dedicated SignalJob identities are invalid or duplicated")
+    active = [row for row in rows if row.get("status") not in {"completed", "failed", "cancelled"}]
+    if allowed_job_id is None:
+        require(not active, "dedicated SignalJob queue is not idle")
+    else:
+        require(len(active) == 1 and active[0].get("job_id") == allowed_job_id
+                and active[0].get("status") == "waiting_for_data" and active[0].get("attempt_count") == 0,
+                "dedicated queue is not exactly the one unclaimed waiting SignalJob")
+    return body
