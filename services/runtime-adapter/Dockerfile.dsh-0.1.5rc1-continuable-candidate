FROM python:3.11-slim-bookworm

# D15-4 isolated candidate image: the coherent DSH 0.1.5-rc.1 pairing with the
# candidate-specific continuable delegate wiring (backgroundMode: continuable,
# enableRunInBackground: true, provider: spawn). This image is never referenced
# by compose.yml, deployment.json or any production selector. It exists only to
# build/observe the unqualified candidate in isolation (no production ports,
# network or shared volume). The production `dsh-0.1.2rc1` profile and its
# foreground delegate behavior are unchanged.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BYQ_DSH_COMPATIBILITY_RELEASE=dsh-0.1.5rc1 \
    BYQ_DSH_COMPOSITION=/opt/byq/profiles/byq-product-continuable.patch.yml \
    BYQ_DSH_COMPOSITION_IDENTITY=/opt/byq/profiles/byq-product-continuable.identity.json \
    BYQ_DSH_RELEASE_IDENTITY=/opt/byq/releases/candidate.identity.json \
    DSH_SESSION_ROOT=/var/lib/byq/dsh-sessions/dsh-0.1.5rc1 \
    DSH_TELEMETRY_DISABLED=1 \
    DSH_PERMISSION_MODE=read-only

WORKDIR /app
COPY services/runtime-adapter/requirements.dsh-0.1.5rc1-candidate.lock ./requirements.candidate.lock
RUN python3 -m pip install --no-cache-dir --require-hashes -r requirements.candidate.lock \
    && python3 -m pip install --no-cache-dir \
       fastapi==0.116.1 httpx==0.28.1 'uvicorn[standard]==0.35.0' pytest==9.0.3

COPY services/runtime-adapter/app ./app
COPY services/runtime-adapter/tests ./tests
COPY packages/contracts ./packages/contracts
COPY packages/operations ./packages/operations
RUN python3 -m pip check \
    && python3 -c "from importlib.metadata import version; assert version('deepseek-harness-sdk') == '0.1.5rc1'; assert version('deepseek-harness-runtime-bin') == '0.1.5rc1'"

# Candidate-specific continuable profile, generated by
# scripts/dsh/candidate_profile.py generate-continuable. The production 0.1.2
# patch is deliberately NOT copied here.
COPY plugins/dsh-byq/profiles/dsh-0.1.5rc1-continuable/byq-product.patch.yml /opt/byq/profiles/byq-product-continuable.patch.yml
COPY plugins/dsh-byq/profiles/dsh-0.1.5rc1-continuable/byq-product.identity.json /opt/byq/profiles/byq-product-continuable.identity.json
COPY plugins/dsh-byq/runtime /opt/byq/runtime
COPY plugins/dsh-byq/skills /opt/dsh/bundles/dsh-byq/skills

RUN groupadd --system --gid 10002 byq \
    && useradd --system --uid 10002 --gid byq --no-create-home \
       --home-dir /var/lib/byq/dsh-runtime-home --shell /usr/sbin/nologin byq \
    && mkdir -p /var/lib/byq/dsh-sessions/dsh-0.1.5rc1 /var/lib/byq/dsh-runtime-home \
    && chown -R byq:byq /var/lib/byq/dsh-sessions /var/lib/byq/dsh-runtime-home \
    && chmod -R a-w /app /opt/byq /opt/dsh

USER byq

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8400"]
