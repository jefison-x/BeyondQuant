{
  "schema_version": "byq-v090-session-containment-contract.v1",
  "identity": {
    "run_pattern": "^[0-9a-f]{32}$",
    "identifier_pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
  },
  "provenance_allowed_sources": [
    "runtime-adapter-test-harness",
    "adapter-containment-ledger",
    "gateway-attempt-ledger",
    "contract-pure-function",
    "lifecycle-journal"
  ],
  "scenarios": [
    {
      "id": "executor-loss-interrupted",
      "required": true,
      "kind": "adapter_loss",
      "expect": {"status": "interrupted", "loss_cause": "executor-loss", "preserved": true}
    },
    {
      "id": "stale-generation-terminal-fenced",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "late-success-no-overwrite",
      "required": true,
      "kind": "adapter_loss",
      "expect": {"status": "interrupted", "history_unchanged": true}
    },
    {
      "id": "duplicate-terminal-rejected",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "terminal-reopen-rejected",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "idempotent-no-receipt-one-attempt-lineage",
      "required": true,
      "kind": "attempt",
      "expect": {"attempts": 1, "auto_retry": true, "lineage_chained": true}
    },
    {
      "id": "success-receipt-not-replayed",
      "required": true,
      "kind": "classification",
      "expect": {"status": "settled", "reason": "existing_success_receipt", "auto_retry": false}
    },
    {
      "id": "unknown-side-effect-paused",
      "required": true,
      "kind": "classification",
      "expect": {"status": "paused", "reason": "non_idempotent_step", "requires_confirmation": true}
    },
    {
      "id": "cancel-blocks-recovery",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "cancelled", "auto_retry": false}
    },
    {
      "id": "budget-exhausted-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "budget_exhausted", "auto_retry": false}
    },
    {
      "id": "authorization-revoked-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "authorization_revoked", "auto_retry": false}
    },
    {
      "id": "owner-workspace-mismatch-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "owner_workspace_mismatch", "auto_retry": false}
    },
    {
      "id": "concurrent-recovery-one-attempt",
      "required": true,
      "kind": "attempt",
      "expect": {"attempts": 1, "conflict": true}
    },
    {
      "id": "observer-breakable",
      "required": true,
      "kind": "meta",
      "expect": {"breakable": true, "defect_targeting_controls": ">=8"}
    }
  ]
}
