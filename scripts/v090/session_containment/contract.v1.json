{
  "schema_version": "byq-v090-session-containment-contract.v2",
  "identity": {
    "run_pattern": "^[0-9a-f]{32}$",
    "identifier_pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
  },
  "provenance_allowed_sources": [
    "runtime-adapter-test-harness",
    "adapter-containment-ledger",
    "contract-pure-function",
    "gateway-session-containment",
    "lifecycle-journal"
  ],
  "scenarios": [
    {
      "id": "executor-loss-interrupted",
      "required": true,
      "kind": "adapter_loss",
      "expect": {"status": "interrupted", "loss_cause": "executor-loss", "before_after_equal": true}
    },
    {
      "id": "late-success-no-overwrite",
      "required": true,
      "kind": "adapter_loss",
      "expect": {"status": "interrupted", "before_after_equal": true}
    },
    {
      "id": "ordinary-failed-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "mismatched-run-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "mismatched-trace-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "missing-summary-session-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "missing-terminal-run-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "invalid-terminal-run-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "failed", "interrupted": false}
    },
    {
      "id": "cancelled-not-interrupted",
      "required": true,
      "kind": "loss_evidence",
      "expect": {"status": "cancelled", "interrupted": false}
    },
    {
      "id": "stale-generation-terminal-fenced",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "duplicate-terminal-rejected",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "terminal-reopen-rejected",
      "required": true,
      "kind": "fencing",
      "expect": {"fenced": true}
    },
    {
      "id": "authority-unavailable-pauses",
      "required": true,
      "kind": "classification",
      "expect": {"status": "paused", "reason": "authority_unavailable", "auto_retry": false}
    },
    {
      "id": "unknown-side-effect-paused",
      "required": true,
      "kind": "classification",
      "expect": {"status": "paused", "reason": "non_idempotent_step", "auto_retry": false}
    },
    {
      "id": "success-receipt-not-replayed",
      "required": true,
      "kind": "classification",
      "expect": {"status": "settled", "reason": "existing_success_receipt", "auto_retry": false}
    },
    {
      "id": "cancel-blocks-recovery",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "cancelled", "auto_retry": false}
    },
    {
      "id": "budget-exhausted-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "budget_exhausted", "auto_retry": false}
    },
    {
      "id": "authorization-revoked-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "authorization_revoked", "auto_retry": false}
    },
    {
      "id": "owner-workspace-mismatch-blocks",
      "required": true,
      "kind": "classification",
      "expect": {"status": "blocked", "reason": "owner_workspace_mismatch", "auto_retry": false}
    },
    {
      "id": "preservation-not-constant",
      "required": true,
      "kind": "preservation",
      "expect": {"before_after_equal": true, "boundary_verified": false, "all_preserved": false}
    },
    {
      "id": "recovery-endpoint-never-submits",
      "required": true,
      "kind": "no_submit",
      "expect": {"submits": false}
    },
    {
      "id": "observer-breakable",
      "required": true,
      "kind": "meta",
      "expect": {"breakable": true, "defect_targeting_controls": ">=8"}
    }
  ]
}
