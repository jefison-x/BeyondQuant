FROM python:3.11-slim-bookworm

# Keyless deterministic provider used only by the isolated D15 runtime
# qualification stack. No credential, no external network, no production data.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SCRIPTED_PROVIDER_PORT=8900

WORKDIR /app
COPY scripts/d15/runtime_continuity/scripted_provider.py ./scripted_provider.py

RUN useradd --system --uid 10005 --no-create-home --shell /usr/sbin/nologin d15 \
    && chown -R d15 /app
USER d15

EXPOSE 8900
CMD ["python3", "scripted_provider.py"]
