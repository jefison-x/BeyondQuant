{
  "schema_version": "byq-v090-dsh-provider-qualification-contract.v1",
  "slice": "v090-dsh-provider-qualification",
  "owner_node": "d15-4-child-provider-remediation",
  "adr": "docs/architecture/adr/ADR-0082-dsh-continuable-child-resume.md",
  "closeout_slices": "docs/evidence/v090-closeout/DSH-015RC1-CLOSEOUT-SLICES.md",
  "examined_versions": [
