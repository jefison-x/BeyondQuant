{
  "name": "@beyondquant/feedback-hub-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --max-workers=1 --no-isolate",
    "test:git-deploy": "node --test scripts/deploy-hub.test.mjs",
    "verify:git-deploy": "node scripts/verify-git-deploy.mjs",
    "check": "npm run typecheck && npm test && npm run test:git-deploy && npm run verify:git-deploy",
    "dry-run": "node scripts/dry-run.mjs",
    "cloudflare:build": "npm run check",
    "cloudflare:preview": "npm run dry-run",
    "cloudflare:deploy:hub": "node scripts/deploy-hub.mjs",
    "cloudflare:deploy:publisher": "wrangler deploy --config wrangler.publisher.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
