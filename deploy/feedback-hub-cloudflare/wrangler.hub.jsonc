{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byq-feedback-hub",
  "main": "../../services/feedback-hub-cloudflare/src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "BYQ_FEEDBACK_HUB_STATUS_SECRET",
      "BYQ_FEEDBACK_HUB_ADMIN_TOKEN",
      "BYQ_FEEDBACK_PUBLISHER_TOKEN"
    ]
  },
  "observability": { "enabled": true },
  "vars": {
    "BYQ_FEEDBACK_GITHUB_REPOSITORY": "jefison-x/BeyondQuant"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "byq-feedback-hub",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INSTALLATION_GATE", "class_name": "InstallationGate" },
      { "name": "FEEDBACK_GATE", "class_name": "FeedbackGate" },
      { "name": "ADMIN_LOGIN_GATE", "class_name": "AdminLoginGate" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InstallationGate", "FeedbackGate"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AdminLoginGate"]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PUBLISH_QUEUE", "queue": "byq-feedback-publish" }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
