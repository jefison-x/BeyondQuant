{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "../../services/feedback-hub-cloudflare/src/**/*.ts",
    "../../workers/feedback-publisher-cloudflare/src/**/*.ts",
    "./tests/**/*.ts",
    "./vitest.config.ts"
  ]
}
