# Required for the internal DSH -> BeyondQuant MCP boundary.
BYQ_MCP_TOKEN=dev-only-change-me

# ADR-0019 application-layer credential encryption. Generate a random
# base64url (unpadded) 32-byte key and keep the JSON key ring outside Git.
# Example generator:
#   python3 -c 'import base64,json,secrets; print(json.dumps({"local-v1": base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("=")}))'
BYQ_CREDENTIAL_KEYRING=
BYQ_CREDENTIAL_ACTIVE_KEY_ID=local-v1
BYQ_CREDENTIAL_RESOLVER_TOKEN=dev-credential-resolver-change-me

# Product Agent lifecycle safety bounds. Defaults are intentionally finite;
# increase only after reviewing the runtime contract and observed workloads.
BYQ_DSH_RUN_TIMEOUT_SECONDS=300
BYQ_DSH_SUBAGENT_TIMEOUT_SECONDS=180
BYQ_DSH_NO_PROGRESS_TIMEOUT_SECONDS=120
BYQ_BACKTEST_ANALYSIS_PAGE_CALL_LIMIT=6
BYQ_BACKTEST_ANALYSIS_PAGE_WINDOW_MS=300000

# Required only for live Phase 8 Tushare integration checks. Never commit a
# real token; keep it in the local ignored .env file.
TUSHARE_TOKEN=

# Durable result-object root for Phase 12 backtests. Compose sets this inside
# the Backend-owned domain volume; do not expose it to Product DSH or MCP.
BYQ_BACKTEST_OBJECT_ROOT=/var/lib/byq/domain/backtest-objects

# PostgreSQL single domain store (ADR-0016). Dev defaults are set in compose;
# production must override these with managed credentials.
POSTGRES_DB=byq_domain
POSTGRES_USER=byq_app
POSTGRES_PASSWORD=change-me
BYQ_DATABASE_URL=postgresql+psycopg://byq_app:change-me@postgres:5432/byq_domain

# PostgreSQL memory baseline for the current single-host deployment. These
# values are restart-time settings. Keep work_mem conservative because it is
# allocated per query operation and can multiply across concurrent sessions.
BYQ_POSTGRES_SHARED_BUFFERS=1GB
BYQ_POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
BYQ_POSTGRES_MAINTENANCE_WORK_MEM=256MB
BYQ_POSTGRES_WORK_MEM=4MB

# Compose resources are project-scoped by default so isolated worktrees cannot
# accidentally mount a running deployment's PostgreSQL volume. Set these only
# when deliberately attaching an existing, verified deployment resource.
# BYQ_PRODUCT_NETWORK_NAME=beyondquant-product
# BYQ_SIGNAL_SANDBOX_NETWORK_NAME=beyondquant-signal-sandbox
# BYQ_POSTGRES_VOLUME_NAME=beyondquant-postgres-data
# BYQ_POSTGRES_VOLUME_EXTERNAL=false
# BYQ_DOMAIN_VOLUME_NAME=beyondquant-domain-state
# BYQ_DSH_SESSIONS_VOLUME_NAME=beyondquant-dsh-sessions
# BYQ_WORKFLOW_TRACES_VOLUME_NAME=beyondquant-workflow-traces
