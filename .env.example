# Required for the internal DSH -> BeyondQuant MCP boundary.
BYQ_MCP_TOKEN=dev-only-change-me

# Required only for live Phase 8 Tushare integration checks. Never commit a
# real token; keep it in the local ignored .env file.
TUSHARE_TOKEN=

# Durable result-object root for Phase 12 backtests. Compose sets this inside
# the Backend-owned domain volume; do not expose it to Product DSH or MCP.
BYQ_BACKTEST_OBJECT_ROOT=/var/lib/byq/domain/backtest-objects
